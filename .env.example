# Settings of the DuckDB port: no accounts and no keys - the warehouse is one local file.
# Copy to .env and fill in. Never commit .env.

# dbt 1.12 loads this file itself; run dbt from the repo root.
DBT_PROJECT_DIR=dbt
DBT_PROFILES_DIR=dbt
# The warehouse file (dbt/profiles.yml). A cache: rebuilt from the landing zone at any time.
DUCKDB_PATH=warehouse/crypto_dwh.duckdb

# The landing zone (extracted batches, ingestion/settings.py). Empty: data/raw in the repo.
# Before the switch-over (2026-11-27) it pointed at the Snowflake original's data/raw,
# read-only, with PIPELINE_MODE=follow.
LANDING_ZONE_DIR=
# rw: the stack may write the landing zone (docker-compose.yaml); goes with PIPELINE_MODE=own.
LANDING_ZONE_ACCESS=rw
# Who writes the landing zone (ingestion/settings.py, the DAG): follow - the original
# extracts and this pipeline only loads what it finds; own - this pipeline extracts too.
PIPELINE_MODE=own

# Airflow (docker-compose.yaml): random values, generated once and never printed.
# Do not change AIRFLOW_POSTGRES_PASSWORD or AIRFLOW_FERNET_KEY once the stack has run:
# postgres keeps the first password, and stored connections are encrypted with the key.
# Fernet key: base64.urlsafe_b64encode(os.urandom(32)).decode() (what Fernet.generate_key()
# returns; the project venv has no cryptography); the rest: secrets.token_urlsafe(32).
AIRFLOW_POSTGRES_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
# Airflow UI login (user created by airflow-init; the password is applied only on creation).
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=

# Alerts (dags/alerting). Telegram bot from @BotFather; the chat id of the chat that gets
# the messages. The bot token is a password: never paste it into a chat or a screenshot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Outside watchdog (healthchecks.io): the ping URL of the check; alerts when pings stop.
PIPELINE_HEARTBEAT_URL=
